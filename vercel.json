{
  "rewrites": [
    {
      "source": "/api-arp/:path*",
      "destination": "https://dadosabertos.compras.gov.br/:path*"
    },
    {
      "source": "/api-pncp/:path*",
      "destination": "https://pncp.gov.br/:path*"
    },
    {
      "source": "/api-contratos-gov/:path*",
      "destination": "https://contratos.comprasnet.gov.br/:path*"
    },
    {
      "source": "/((?!assets/|favicon|logo|icons).*)",
      "destination": "/index.html"
    }
  ]
}
